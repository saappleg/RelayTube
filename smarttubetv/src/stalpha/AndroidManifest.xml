<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.liskovsoft.smartyoutubetv2.common.integration.relay.RelayProfileReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="${applicationId}.ACCESS_VIDEO_DATA">
            <intent-filter>
                <action android:name="com.relaytube.action.SELECT_PROFILE" />
                <action android:name="com.relaytube.action.REQUEST_PROFILES" />
            </intent-filter>
        </receiver>

        <provider
            android:name="com.liskovsoft.smartyoutubetv2.common.integration.relay.RelayProfilesProvider"
            android:authorities="${applicationId}.relayprofiles"
            android:enabled="true"
            android:exported="true"
            android:permission="${applicationId}.ACCESS_VIDEO_DATA"
            android:readPermission="${applicationId}.ACCESS_VIDEO_DATA"
            android:writePermission="${applicationId}.ACCESS_VIDEO_DATA" />
    </application>
</manifest>
